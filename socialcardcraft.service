[Unit]
Description=SocialCardCraft FastAPI App
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/socialcardcraft
EnvironmentFile=/home/ubuntu/projects/socialcardcraft/.env
ExecStart=/home/ubuntu/projects/socialcardcraft/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8010 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
