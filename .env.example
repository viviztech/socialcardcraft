# App
APP_NAME=SocialCardCraft
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://socialcard_user:socialcard_pass@localhost:5432/socialcardcraft_db

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=socialcardcraft-media

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# App URL
BASE_URL=http://localhost:8013
PORT=8013

# Admin
ADMIN_EMAIL=admin@socialcardcraft.com
ADMIN_PASSWORD=Admin@1234

# ── AI Configuration ───────────────────────────────────────────────────────────
# Priority: Claude → OpenAI → Ollama → rule-based fallback
# At least one is enough. Leave blank to use fallback mode.

# Claude API (Anthropic) — best for Indian languages
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternative)
OPENAI_API_KEY=sk-...

# Ollama local (free, runs on your server)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── Image Generation ───────────────────────────────────────────────────────────
# Provider: stability | replicate | none
IMAGE_GEN_PROVIDER=none

# Stability AI (SDXL) — https://platform.stability.ai
STABILITY_API_KEY=sk-...

# Replicate (FLUX Schnell) — https://replicate.com
REPLICATE_API_TOKEN=r8_...
